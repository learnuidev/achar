{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@achar/types": [
        "../../packages/types/src/index.ts"
      ],
      "@achar/schema": [
        "../../packages/schema/src/index.ts"
      ],
      "@achar/api": [
        "../../packages/api/src/index.ts"
      ],
      "@achar/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@achar/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@ui/*": [
        "../../packages/ui/src/*"
      ],
      "@api/*": [
        "../../packages/api/src/*"
      ],
      "@auth/*": [
        "../../packages/auth/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
